APP_NAME="Gestao Mix7"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestao.mix7.org

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=gestao_mix7
DB_USERNAME=mix7_app
DB_PASSWORD='PREENCHA_NO_EDITOR'
DB_SSLMODE=disable
DB_SSLROOTCERT=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mix7.com.br"
MAIL_FROM_NAME="Gestao Mix7"

# Instancia OpenClaw dedicada, opcional e sem porta publica. Defina em .env privado
# somente apos revisar a configuracao e a politica de dados da Mix7.
AI_PROVIDER=openclaw-internal
AI_BASE_URL=http://openclaw:18789/v1
AI_MODEL=openclaw/mix7
AI_API_KEY=
OPENCLAW_IMAGE=
OPENCLAW_STATE_DIR=
